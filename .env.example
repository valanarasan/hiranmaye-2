# Copy to .env.local and fill in. Vite only exposes VITE_-prefixed variables to
# the browser, and everything here is public by definition — the endpoint URL
# ships inside the bundle. The token below is a spam speed bump, not a secret.

# The /exec URL from Deploy -> New deployment -> Web app in Apps Script.
VITE_LEAD_ENDPOINT=

# Must match SHARED_TOKEN in scripts/lead-notify.gs. Leave both blank to skip.
VITE_LEAD_TOKEN=
